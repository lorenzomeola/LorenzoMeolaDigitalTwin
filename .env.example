# Backend (FastAPI). Set at least one provider key; providers without a key are hidden.
OPENAI_API_KEY=replace-with-server-only-openai-key
GROQ_API_KEY=replace-with-server-only-groq-key
OPENROUTER_API_KEY=replace-with-server-only-openrouter-key
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Frontend, local development only. On Vercel the service binding injects BACKEND_URL.
CHAT_API_URL=http://localhost:8000