# Backend (FastAPI). Set at least one provider key; providers without a key are hidden.
OPENAI_API_KEY=replace-with-server-only-openai-key
GROQ_API_KEY=replace-with-server-only-groq-key
OPENROUTER_API_KEY=replace-with-server-only-openrouter-key
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Shared chat rate limits (fixed UTC minute/day windows). Apply database/schema.sql first.
CHAT_RATE_PER_MINUTE=10
CHAT_RATE_PER_DAY=100
# Optional stable HMAC secret; DATABASE_URL is the fallback. Never expose to the client.
RATE_LIMIT_SALT=
# The output reviewer always uses OpenAI gpt-4.1-mini and requires OPENAI_API_KEY.

# Frontend, local development only. On Vercel the service binding injects BACKEND_URL.
CHAT_API_URL=http://localhost:8000